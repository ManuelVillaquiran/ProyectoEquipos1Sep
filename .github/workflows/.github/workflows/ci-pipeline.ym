name: Django CI Pipeline

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      - name: Obtener el código del repositorio
        uses: actions/checkout@v4

      - name: Configurar versión de Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.14"

      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          if [ -f proyectoEquipos/requirements.txt ]; then pip install -r proyectoEquipos/requirements.txt; fi

      - name: Ejecutar migraciones de la base de datos
        run: |
          cd proyectoEquipos
          python manage.py migrate

      - name: Ejecutar pruebas unitarias
        run: |
          cd proyectoEquipos
          python manage.py test
